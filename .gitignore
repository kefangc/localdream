# Editor and IDE state
.idea/
.vscode/

# Go build output
*.exe
*.exe~
*.test
coverage.out

# Frontend dependencies and production output
frontend/node_modules/
frontend/dist/
node_modules/
# npm dependencies are managed in frontend/, not at the Go project root.
/package-lock.json

# Runtime state, generated media, and local secrets
/data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.log
.env
.env.*
!.env.example
!.env.sample
config.local.cmd

# Locally generated distribution archives.
release/

# Stale interpreter cache from the removed legacy adapter.
__pycache__/
*.py[cod]
/adapter/

# Local browser QA artifacts.
.playwright-cli/
/output/
frontend/preview-*.png

# Keep only project READMEs and MCP documentation under version control.
# The embedded H3 guide is a runtime resource served by MCP, not project notes.
*.md
!/README.md
!/frontend/README.md
!/packaging/README.md
!/docs/mcp*.md
!/internal/skills/builtin/h3-prompt-writing/SKILL.md
